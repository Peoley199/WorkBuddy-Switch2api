  "cards": [
    { "dot": "cyan", "title": "切换主路径", "items": ["备份 → 关闭 → 处理会话 → 写认证 → 重启，切换过程实时进度反馈", "账号自带版本标记，不能跨档位切换", "国内版与国际版各有一份认证文件，写入按档位取"] },
    { "dot": "violet", "title": "会话复制 / 共享", "items": ["复制：把勾选会话以新 id 复制给目标账号，源数据不动", "共享：把 user_id 置空，任何账号登录看到同一份，不产生副本", "两个档位各自作用于自己的 workbuddy.db"] },
